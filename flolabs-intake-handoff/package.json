{
  "name": "flolabs-intake-forms",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node --env-file=.env.local node_modules/vitest/vitest.mjs run live.test",
    "test:live-write": "node --env-file=.env.local scripts/run-live-write.mjs",
    "make-link": "node --env-file=.env.local --conditions=react-server scripts/make-form-link.mts",
    "make-email-draft": "node --env-file=.env.local --conditions=react-server scripts/make-hr-email-draft.mts",
    "block-hr-email:test": "node --env-file=.env.local --conditions=react-server scripts/block-hr-email-test.mts",
    "send-hr-email:test": "node --env-file=.env.local --conditions=react-server scripts/send-hr-email-test.mts",
    "sync-crm-email:test": "node --env-file=.env.local --conditions=react-server scripts/sync-crm-email-test.mts",
    "inspect-crm-email:test": "node --env-file=.env.local --conditions=react-server scripts/inspect-crm-email-test.mts",
    "build:ses-feedback": "esbuild infra/aws/ses-feedback/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=infra/aws/dist/handler.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1002.0",
    "@aws-sdk/lib-dynamodb": "3.1002.0",
    "imapflow": "2.9.1",
    "libphonenumber-js": "1.13.15",
    "mailparser": "3.12.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
