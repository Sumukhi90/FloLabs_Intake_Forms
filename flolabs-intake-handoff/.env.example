# Copy to .env.local and fill in. Never commit .env.local.
TWENTY_BASE_URL=https://157-230-82-204.sslip.io
TWENTY_API_KEY=

# Cloudflare Turnstile (T7). Required in production (`next start`); in development the app
# falls back to Cloudflare's public test keys, which always pass.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Header with the real client IP set by your proxy (rate limits). REQUIRED in production:
# cf-connecting-ip behind Cloudflare, x-real-ip or x-forwarded-for behind nginx/Caddy. Leave
# unset locally.
# TRUSTED_IP_HEADER=cf-connecting-ip

# Signs the Form 1-3 links (T10). REQUIRED in production; at least 32 random characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
# Changing it cancels every link not used yet.
# LINK_TOKEN_SECRET=

# Optional until the suppression/unsubscribe store is provisioned.
# The app uses its AWS execution role/default credential chain; do not add AWS keys here.
# AWS_REGION=
# SUPPRESSION_TABLE_NAME=

# Local mailbox test integration (backend only). Keep the real password in .env.local,
# never in source control, frontend-prefixed variables, or shell history.
# CRM_EMAIL_IMAP_HOST=flolabsinnovations.com
# CRM_EMAIL_IMAP_PORT=993
# CRM_EMAIL_IMAP_USERNAME=crm.test1@flolabsinnovations.com
# CRM_EMAIL_IMAP_PASSWORD=
# CRM_EMAIL_SMTP_HOST=flolabsinnovations.com
# CRM_EMAIL_SMTP_PORT=465
# CRM_EMAIL_SMTP_USERNAME=crm.test1@flolabsinnovations.com
# CRM_EMAIL_SMTP_PASSWORD=
# CRM_EMAIL_ALLOWED_RECIPIENTS=crm.test1@flolabsinnovations.com
# CRM_EMAIL_DATABASE_PATH=.local/email.sqlite
# CRM_EMAIL_TEST_COMMANDS_ENABLED=true
# Set only when intentionally adding a test recipient to the local blocklist.
# CRM_EMAIL_TEST_BLOCK_RECIPIENT=approved-test@example.com
